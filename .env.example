# App client PÚBLICO (sin client secret). El client con secret del servidor no sirve en el navegador.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Invoke URL del HTTP API, con /api/v1 y sin barra final
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_API_IDENTITY=http://localhost:8081/api/v1
VITE_API_TRABAJADORES=http://localhost:8082/api/v1
VITE_API_CONTRATOS=http://localhost:8083/api/v1
VITE_API_ASISTENCIA=http://localhost:8084/api/v1
VITE_API_AUSENCIAS=http://localhost:8085/api/v1
VITE_API_NOTIFICATIONS=http://localhost:8086/api/v1
